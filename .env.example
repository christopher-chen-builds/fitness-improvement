# PrecisionFit — Environment Configuration
# Copy this file to .env and fill in your values.

# ─── Supabase (Required) ───
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# ─── AI Image Generation (Optional) ───
# Set to "false" to disable AI exercise images entirely
VITE_AI_IMAGE_ENABLED="true"

# ─── Edge Function Secrets (set via supabase secrets set) ───
# AI_API_URL     — OpenAI-compatible endpoint (default: Lovable gateway)
# AI_API_KEY     — API key for the AI endpoint
# AI_IMAGE_MODEL — Model name (default: google/gemini-2.5-flash-image)
